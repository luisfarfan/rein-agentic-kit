#!/usr/bin/env python3
"""Alias so `token-report` works directly if the plugin's bin/ lands on PATH.

The canonical entrypoint is `rein token-report`; this exists because we do not
yet know (A3 of phase 0) whether Claude Code puts a plugin's bin/ on PATH, and
if it does, both spellings should work.
"""

import os
import sys

sys.path.insert(0, os.path.join(os.path.dirname(os.path.abspath(os.path.realpath(__file__))), "..", "lib"))

import token_report  # noqa: E402

raise SystemExit(token_report.main(sys.argv[1:]))
