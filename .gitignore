node_modules/
__pycache__/
*.pyc
.DS_Store
.venv/
dist/
build/

# The root flow.config.json IS tracked: this repo is its own consuming project
# (the kit is developed with the kit), so it doubles as a live example.

# Local scratch from POC runs
/.scratch/

# Serena's per-project state (language-server cache, project config).
# Local and machine-specific: it must not travel with the repo.
.serena/

# graphify's code-graph index: machine-local and regenerated, never committed.
graphify-out/

# CodeGraph's local index: tree-sitter -> SQLite, regenerated, never committed.
.codegraph/

# Never committed, and never written by this project: secrets belong in
# the tool that owns them, not in the repo.
.env
.env.*

# Generated packaging metadata: two copies of it disagreed during a rename,
# and one still embedded the retired command names. Regenerated on every build.
*.egg-info/

# rein: local projection record. Plane is removable (D1), so its
# bookkeeping does not belong in the repo -- a fresh clone simply
# re-syncs, which is idempotent by construction. Narrow on purpose:
# `.rein/` wholesale would also swallow `.rein/workspace.json`, the
# descriptor T001 exists to read and which SHOULD be committed.
.rein/plane_record.json
